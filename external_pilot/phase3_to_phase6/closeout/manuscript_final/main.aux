\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces SBG~V8{} architecture as implemented. Each run of $P$ or $P'$ is a fresh sandboxed child. The trusted controller holds the anchor key $K$, which never enters the child; captures an independent tee of standard output; and checks the HMAC-authenticated result frame. Validation of the sealed evidence directory gates the verdict. Shadow re-observation and reviewer-supplied inputs feed optional checks that report issues but do not change the verdict.}}{10}{}\protected@file@percent }
\newlabel{fig:architecture}{{2}{10}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Evidence lifecycle for one change pair, with the implementing module under each stage. Any failure in capture, sealing or validation, and any abstention on inadequate evidence, leads to INS{} (lower lane). Stage~8 is a label-free audit that operates on copies.}}{10}{}\protected@file@percent }
\newlabel{fig:lifecycle}{{3}{10}{}{figure.3}{}}
